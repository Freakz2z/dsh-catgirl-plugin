{
  "name": "dsh-catgirl-plugin-client",
  "version": "0.1.0",
  "description": "Neko web client: decorates assistant text at the conversation render layer (session log stays raw)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-attachment": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@types/react": "^18.3.31",
    "react": "^18.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0"
  }
}